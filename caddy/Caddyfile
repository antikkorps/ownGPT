# Caddy 2.11 — reverse proxy unique (seuls 80/443 sont exposés sur l'hôte).
#
# Le mode est choisi par les adresses de site dans .env :
#   VPS    : OPENWEBUI_SITE=chat.exemple.fr        → HTTPS Let's Encrypt automatique
#            LITELLM_SITE=api.exemple.fr
#   Maison : OPENWEBUI_SITE=http://chat.exemple.fr → HTTP simple ; le HTTPS est assuré par
#            LITELLM_SITE=http://api.exemple.fr       Cloudflare Tunnel
#   LAN    : OPENWEBUI_SITE=chat.192-168-1-10.nip.io + CADDY_TLS=internal → HTTPS par
#            l'autorité locale de Caddy (racine à installer sur les postes : scripts/export-ca.sh)

{
	email {$ACME_EMAIL:admin@example.invalid}
	admin off
	# CADDY_TLS=internal: the local CA root cannot be installed in a container trust store.
	skip_install_trust
	servers {
		# Seul cloudflared (IP fixe sur le réseau Docker) peut transmettre l'IP réelle du
		# client : ni un poste du LAN ni la passerelle Docker ne peuvent usurper une IP admin.
		trusted_proxies static {$CLOUDFLARED_IP}
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

# Routes d'administration : refusées hors des IP autorisées (ADMIN_ALLOWED_IPS).
(admin_seulement) {
	@hors_admin not client_ip {$ADMIN_ALLOWED_IPS}
	respond @hors_admin "Accès refusé" 403
}

(securite) {
	# TLS mode: caddy/tls/acme (default, Let's Encrypt or plain HTTP) or caddy/tls/internal.
	import tls/{$CADDY_TLS:acme}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# --- Interface de chat (Open WebUI) -------------------------------------------
{$OPENWEBUI_SITE} {
	import securite
	request_body {
		max_size 50MB
	}
	reverse_proxy openwebui:8080
}

# --- Passerelle API (LiteLLM) -------------------------------------------------
# Liste blanche : seules les routes utilisées par les clients prévus (chat OpenAI pour
# Open WebUI / OpenCode / scripts, Anthropic /v1/messages pour Claude Code, liste des
# modèles) sont publiques, et exigent une clé virtuelle. Surface minimale : pas de
# /v1/completions, /v1/embeddings, /v1/responses, /v1/files… tant qu'aucun usage ne le
# demande. Tout le reste (UI /ui, /login, /key/*, /team/*, /config/*…) est de
# l'administration, réservée à ADMIN_ALLOWED_IPS.
{$LITELLM_SITE} {
	import securite
	request_body {
		max_size 20MB
	}
	# L'identité de l'utilisateur n'est crue que venant d'Open WebUI, qui parle à LiteLLM en
	# direct sur le réseau interne ; les en-têtes de contrôle LiteLLM (tags, désactivation de
	# callbacks, id utilisateur…) ne servent à aucun client légitime. Retirés sur tout le site.
	request_header -X-OpenWebUI-*
	request_header -X-LiteLLM-*

	@modeles path /v1/chat/completions /chat/completions /v1/messages /v1/messages/* /v1/models /v1/models/* /models /health/liveliness /health/readiness
	handle @modeles {
		reverse_proxy litellm:4000 {
			# Streaming (SSE) sans mise en tampon.
			flush_interval -1
		}
	}

	handle {
		import admin_seulement
		reverse_proxy litellm:4000
	}
}
