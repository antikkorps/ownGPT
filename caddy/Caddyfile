# Caddy 2.11 — reverse proxy unique (seuls 80/443 sont exposés sur l'hôte).
#
# Le mode est choisi par les adresses de site dans .env :
#   VPS    : OPENWEBUI_SITE=chat.exemple.fr        → HTTPS Let's Encrypt automatique
#            LITELLM_SITE=api.exemple.fr
#   Maison : OPENWEBUI_SITE=http://chat.exemple.fr → HTTP simple ; le HTTPS est assuré par
#            LITELLM_SITE=http://api.exemple.fr       Cloudflare Tunnel (ou LAN : *.nip.io)

{
	email {$ACME_EMAIL:admin@example.invalid}
	admin off
	servers {
		# Seul cloudflared (IP fixe sur le réseau Docker) peut transmettre l'IP réelle du
		# client : ni un poste du LAN ni la passerelle Docker ne peuvent usurper une IP admin.
		trusted_proxies static {$CLOUDFLARED_IP}
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

# Routes d'administration : refusées hors des IP autorisées (ADMIN_ALLOWED_IPS).
(admin_seulement) {
	@hors_admin not client_ip {$ADMIN_ALLOWED_IPS}
	respond @hors_admin "Accès refusé" 403
}

(securite) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# --- Interface de chat (Open WebUI) -------------------------------------------
{$OPENWEBUI_SITE} {
	import securite
	request_body {
		max_size 50MB
	}
	reverse_proxy openwebui:8080
}

# --- Passerelle API (LiteLLM) -------------------------------------------------
# Liste blanche : seules les routes de modèles (OpenAI + Anthropic) sont publiques, et
# exigent une clé virtuelle. Tout le reste (UI /ui, /login, /key/*, /team/*, /config/*…)
# est de l'administration, réservée à ADMIN_ALLOWED_IPS.
{$LITELLM_SITE} {
	import securite
	request_body {
		max_size 20MB
	}

	@modeles path /v1/chat/completions /v1/completions /v1/embeddings /v1/models /v1/models/* /v1/messages /v1/messages/* /chat/completions /completions /embeddings /models /health/liveliness /health/readiness
	handle @modeles {
		reverse_proxy litellm:4000 {
			# L'identité de l'utilisateur n'est crue que venant d'Open WebUI, qui parle à
			# LiteLLM en direct sur le réseau interne : depuis l'extérieur, on la retire.
			header_up -X-OpenWebUI-User-Name
			header_up -X-OpenWebUI-User-Id
			header_up -X-OpenWebUI-User-Email
			header_up -X-OpenWebUI-User-Role
			header_up -X-OpenWebUI-User-Auth-Type
			header_up -X-OpenWebUI-User-Jwt
			header_up -X-OpenWebUI-Chat-Id
			header_up -X-OpenWebUI-Message-Id
			# Streaming (SSE) sans mise en tampon.
			flush_interval -1
		}
	}

	handle {
		import admin_seulement
		reverse_proxy litellm:4000
	}
}

# --- Authentik (profil sso uniquement ; 502 tant que le profil n'est pas lancé) ---
{$AUTHENTIK_SITE} {
	import securite
	@console path /if/admin /if/admin/*
	handle @console {
		import admin_seulement
		reverse_proxy authentik-server:9000
	}
	handle {
		reverse_proxy authentik-server:9000
	}
}
