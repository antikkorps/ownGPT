# --- Secrets: never commit (provider keys, master key, passwords) ---
.env
.env.*
!.env.example
secrets*.txt
*.pem
*.key
*.p12
*.pfx
*.jks
.netrc
integrations/**/.env

# --- Backups and dumps (encrypted or not, still company data) ---
backups/
*.tar.enc
*.tar.enc.mac
*.tar.enc.sha256
*.sql
*.sql.gz
*.dump
*.bak

# --- Local overrides (machine-specific ports, test models, extra_hosts) ---
docker-compose.override.yml
compose.override.yml

# --- Local tool settings that may hold a gateway key ---
.claude/
opencode.local.json
*.local.*
integrations/claude-code/settings.json

# --- Python ---
__pycache__/
*.pyc
.venv/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# --- Logs ---
*.log
