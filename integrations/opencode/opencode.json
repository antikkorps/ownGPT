{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "passerelle": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Passerelle IA Société Exemple",
      "options": {
        "baseURL": "https://api.exemple.fr/v1",
        "apiKey": "{env:OWNGPT_OPENCODE_KEY}"
      },
      "models": {
        "glm": {
          "name": "GLM 5.3 — Mistral UE (code, conseillé)",
          "limit": { "context": 200000, "output": 32000 }
        },
        "devstral": {
          "name": "Devstral — Mistral",
          "limit": { "context": 128000, "output": 32000 }
        },
        "mistral-medium": {
          "name": "Mistral Medium",
          "limit": { "context": 128000, "output": 16000 }
        }
      }
    }
  },
  "model": "passerelle/glm",
  "small_model": "passerelle/mistral-medium"
}
