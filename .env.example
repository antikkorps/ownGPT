# =============================================================================
# Configuration — copier en .env (jamais versionné) : cp .env.example .env
# Générer tous les secrets d'un coup :  ./scripts/gen-secrets.sh --apply
# (remplit les valeurs vides de .env ; ou un par un : openssl rand -hex 32)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. MODE DE DÉPLOIEMENT (adresses de site Caddy)
# -----------------------------------------------------------------------------
# --- Mode MAISON + Cloudflare Tunnel (par défaut) ---
# Préfixe http:// = Caddy sert en HTTP ; le HTTPS public est assuré par Cloudflare.
# Lancer avec : docker compose --profile tunnel up -d
OPENWEBUI_SITE=http://chat.exemple.fr
LITELLM_SITE=http://api.exemple.fr
OPENWEBUI_URL=https://chat.exemple.fr
CLOUDFLARE_TUNNEL_TOKEN=
# Exposer 80/443 seulement en local (tunnel uniquement) : 127.0.0.1 ; LAN : 0.0.0.0
HTTP_BIND=127.0.0.1
# Certificats : acme (Let's Encrypt pour les sites sans http://, HTTP simple pour les sites
# http://) ou internal (autorité locale de Caddy, mode LAN ci-dessous).
CADDY_TLS=acme
# Ports hôte (changer si 80/443 sont déjà pris sur le serveur maison ; garder 80/443 en VPS)
HTTP_PORT=80
HTTPS_PORT=443

# --- Mode MAISON en LAN sans tunnel (exemple, IP du serveur 192.168.1.10) ---
# HTTPS par l'autorité locale de Caddy (sites SANS http:// + CADDY_TLS=internal), puis
# ./scripts/export-ca.sh et installer le certificat racine sur les postes.
# OPENWEBUI_SITE=chat.192-168-1-10.nip.io
# LITELLM_SITE=api.192-168-1-10.nip.io
# OPENWEBUI_URL=https://chat.192-168-1-10.nip.io
# CADDY_TLS=internal          (remplace CADDY_TLS=acme ci-dessus)
# HTTP_BIND=192.168.1.10

# --- Mode VPS (IP publique + DNS A chat./api. → IP du VPS) ---
# Sans préfixe http:// : HTTPS Let's Encrypt automatique.
# OPENWEBUI_SITE=chat.exemple.fr
# LITELLM_SITE=api.exemple.fr
# OPENWEBUI_URL=https://chat.exemple.fr
# ACME_EMAIL=admin@exemple.fr
# HTTP_BIND=0.0.0.0

# IP autorisées pour TOUTE l'administration LiteLLM (tableau de bord /ui, /login, API /key,
# /team, /config…). Les routes de modèles (/v1/…) restent ouvertes
# à tous (clé virtuelle exigée). Défaut : réseaux privés (LAN). Depuis Internet (tunnel,
# VPS), ajouter votre IP publique, ex. : ADMIN_ALLOWED_IPS="203.0.113.4/32 192.168.1.0/24"
# — ou mieux, protéger api.<domaine> par Cloudflare Access / un VPN.
# 172.16.0.0/12 et fc00::/7 sont exclus exprès : ils contiennent les passerelles Docker
# (IPv4 et IPv6), par lesquelles peuvent arriver des connexions Internet relayées par
# docker-proxy — ne pas les ajouter. Idéalement, réduire à votre seul réseau, ex. 192.168.1.0/24.
ADMIN_ALLOWED_IPS="127.0.0.1/8 ::1/128 10.0.0.0/8 192.168.0.0/16"
# Sous-réseau du réseau Docker interne (changer seulement s'il entre en conflit avec le LAN)
DOCKER_SUBNET=172.31.250.0/24
# IP fixe de cloudflared dans ce sous-réseau : seul proxy dont Caddy croit l'IP client
CLOUDFLARED_IP=172.31.250.250

# -----------------------------------------------------------------------------
# 2. FOURNISSEURS LLM
# -----------------------------------------------------------------------------
# Mistral AI — https://console.mistral.ai → API Keys (obligatoire)
MISTRAL_API_KEY=

# Scaleway Generative APIs (optionnel) — https://console.scaleway.com → IAM → API keys
# Pour activer : renseigner la clé ET LITELLM_CONFIG=config.scaleway.yaml
SCALEWAY_API_KEY=
LITELLM_CONFIG=config.yaml
# Identifiants Scaleway à confirmer avec : ./scripts/list-provider-models.sh scaleway
SCALEWAY_MODEL_DEEPSEEK=scaleway/deepseek-v4-flash
SCALEWAY_MODEL_QWEN=scaleway/qwen3.6-35b-a3b
SCALEWAY_MODEL_MISTRAL_SMALL=scaleway/mistral-small-3.2-24b-instruct-2506

# Non utilisés en démo (modèles commentés dans litellm/config.yaml)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# ⚠️ Données stockées en Chine — groupe admin, tests perso, JAMAIS de données réelles
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=

# -----------------------------------------------------------------------------
# 3. SECRETS (openssl rand -hex 32) — ne jamais réutiliser entre environnements
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
OPENWEBUI_DB_PASSWORD=
LITELLM_DB_PASSWORD=

# Clé maître LiteLLM : doit commencer par « sk- »
LITELLM_MASTER_KEY=
# Chiffre les identifiants stockés en base : NE PLUS LA CHANGER après le 1er démarrage
LITELLM_SALT_KEY=
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=
# Verbosité des logs LiteLLM (WARNING par défaut ; INFO/DEBUG pour diagnostiquer, à
# remettre ensuite : DEBUG peut écrire des en-têtes et des fragments de requêtes)
LITELLM_LOG=WARNING

WEBUI_SECRET_KEY=
# Administrateur Open WebUI (créé automatiquement au 1er démarrage)
OPENWEBUI_ADMIN_EMAIL=admin@demo.example.com
OPENWEBUI_ADMIN_PASSWORD=
OPENWEBUI_ADMIN_NAME=Administrateur
# Comptes de démo standard@ / avance@demo.example.com : créés par import_seed.py seulement
# si CREATE_DEMO_USERS=true (ils sont joignables depuis Internet en mode VPS / tunnel).
# Mot de passe commun ≥ 16 caractères (généré). Après la démo :
#   docker compose exec openwebui python3 /seed/import_seed.py --supprimer-comptes-demo
CREATE_DEMO_USERS=false
DEMO_USERS_PASSWORD=

# Clés virtuelles LiteLLM, une par usage (format sk-<hex>). Générées ici pour que
# l'installation soit reproductible ; enregistrées par ./scripts/create-keys.sh
LITELLM_KEY_OPENWEBUI=
LITELLM_KEY_OPENCODE=
LITELLM_KEY_CLAUDECODE=
LITELLM_KEY_AUTOMATION=

# Sauvegardes chiffrées (scripts/backup.sh) — à conserver HORS du serveur
BACKUP_PASSPHRASE=
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# -----------------------------------------------------------------------------
# 4. OPEN WEBUI
# -----------------------------------------------------------------------------
WEBUI_NAME="IA Société Exemple"
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# -----------------------------------------------------------------------------
# 5. SSO (optionnel) — OIDC direct sur l'annuaire de l'entreprise (Entra ID, Google
#    Workspace, Keycloak…), sans composant supplémentaire. Désactivé par défaut.
#    Redirect URI à déclarer chez le fournisseur : https://chat.<domaine>/oauth/oidc/login/callback
# -----------------------------------------------------------------------------
ENABLE_OAUTH_SIGNUP=false
OAUTH_PROVIDER_NAME="SSO entreprise"
# ex. Entra ID : https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
OPENID_PROVIDER_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
ENABLE_OAUTH_GROUP_MANAGEMENT=false
# Ne passer à true que si le fournisseur garantit des e-mails vérifiés (sinon : prise de compte)
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=false
